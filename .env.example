# ═══════════════════════════════════════════════
# Metallics — Environment Variables
# ═══════════════════════════════════════════════
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ═══════════════════════════════════════════════

# ── Frontend (safe to expose — public Supabase keys) ──
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key-here
VITE_APP_URL=http://localhost:5173

# ── Edge Functions (server-side ONLY — NEVER use VITE_ prefix) ──
# Set these via: supabase secrets set SERVICE_ROLE_KEY=...
# SERVICE_ROLE_KEY=your-service-role-key-here
#
# SUPABASE_URL is automatically available in Edge Functions.
